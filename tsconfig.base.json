{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "strictPropertyInitialization": false,
    // "strict": true,
    "target": "ES2022",
    "module": "esnext",
    "typeRoots": ["node_modules/@types", "libs-internal/local-types"],
    "types": ["node", "dev-mode-types"],
    "lib": ["es2018", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@pebula-internal/*": ["libs-internal/*/src/index.ts", "libs-internal/*"],
      "@pebula-internal/nx-repo-plugins": [
        "libs-internal/nx-repo-plugins/src/index.ts"
      ],
      "@pebula/*": ["libs/*/src/index.ts", "libs/*"],
      "@pebula/apps/*": ["apps/libs/*", "apps/libs/*/src/index.ts"],
      "@pebula/ngrid-bootstrap/lib/*": ["libs/ngrid-bootstrap/src/lib/*"],
      "@pebula/ngrid-cypress/lib/*": ["libs/ngrid-cypress/src/lib/*"],
      "@pebula/ngrid-material/lib/*": ["libs/ngrid-material/src/lib/*"],
      "@pebula/ngrid/core/lib/*": ["libs/ngrid/core/src/lib/*"],
      "@pebula/ngrid/lib/*": ["libs/ngrid/src/lib/*"],
      "@pebula/workspace-plugin": ["tools/workspace-plugin/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "node_modules/esbuild/lib/main.d.ts",
    "libs-internal/local-types/dev-mode-types/index.d.ts"
  ],
  "exclude": ["dist", "node_modules", "tmp"]
}
