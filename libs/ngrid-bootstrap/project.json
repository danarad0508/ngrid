{
  "name": "ngrid-bootstrap",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": ["name:ngrid-bootstrap", "type:lib", "parent:ngrid"],
  "sourceRoot": "libs/ngrid-bootstrap/src",
  "projectType": "library",
  "prefix": "pbl",
  "targets": {
    "build": {
      "executor": "@nrwl/angular:package",
      "outputs": ["{workspaceRoot}/dist/pebula/ngrid-bootstrap"],
      "options": {
        "tsConfig": "libs/ngrid-bootstrap/tsconfig.lib.json",
        "project": "libs/ngrid-bootstrap/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ngrid-bootstrap/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/ngrid-bootstrap/tsconfig.lib.json"
        }
      },
      "dependsOn": ["^build"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/ngrid-bootstrap"],
      "options": {
        "jestConfig": "libs/ngrid-bootstrap/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
