{
  "name": "ngrid-cypress",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": ["name:ngrid-cypress", "type:lib", "parent:ngrid"],
  "sourceRoot": "libs/ngrid-cypress/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nrwl/angular:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "tsConfig": "libs/ngrid-cypress/tsconfig.lib.json",
        "project": "libs/ngrid-cypress/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ngrid-cypress/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/ngrid-cypress/tsconfig.lib.json"
        }
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/ngrid-cypress/**/*.ts"]
      }
    }
  }
}
