{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["jasmine", "node", "dev-mode-types"],
    "target": "ES2022",
    "useDefineForClassFields": false
  },
  "files": ["src/__test-runners/karma-test.ts", "src/polyfills.ts"],
  "include": ["**/*.spec.ts", "**/*.test.ts", "**/*.d.ts"],
  "exclude": ["jest.config.ts"]
}
