{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node", "dev-mode-types"]
  },
  "include": ["src/main.ts", "src/polyfills.ts","../../node_modules/esbuild/lib/main.d.ts"],
  "exclude": [
    "src/__test-runners/*.ts",
    "src/main.server.ts",
